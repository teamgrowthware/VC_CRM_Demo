generator client {
  provider = "prisma-client-js"
}

generator client_backend {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Department {
  id        String     @id @default(uuid())
  name      String     @unique
  employees Employee[]
  projects  Project[]
}

model Team {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  createdAt   DateTime       @default(now())
  projects    Project[]
  members     TeamMember[]
}

model TeamMember {
  id         String   @id @default(uuid())
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())

  @@unique([teamId, employeeId])
}

model Employee {
  id                       String                @id @default(uuid())
  employeeId               String                @unique
  name                     String
  email                    String                @unique
  password                 String
  phone                    String?
  avatarUrl                String?
  departmentId             String?
  department               Department?           @relation(fields: [departmentId], references: [id])
  designation              String
  role                     Role                  @default(EMPLOYEE)
  status                   EmployeeStatus        @default(ACTIVE)
  joiningDate              DateTime              @default(now())
  dateOfBirth              DateTime?
  attendance               Attendance[]
  deviceLogs               AttendanceDeviceLog[]
  leaves                   Leave[]
  managedProjects          Project[]             @relation("ProjectManager")
  projectMembers           ProjectMember[]
  tasks                    Task[]                @relation("AssignedTasks")
  createdTasks             Task[]                @relation("CreatedTasks")
  comments                 Comment[]
  notifications            Notification[]
  activityLogs             ActivityLog[]
  dailyReports             DailyReport[]
  sentMessages             Message[]             @relation("SentMessages")
  receivedMessages         Message[]             @relation("ReceivedMessages")
  chatMemberships          ChatMember[]
  timeEntries              TimeEntry[]
  leads                    Lead[]
  reviews                  PerformanceReview[]   @relation("EmployeeReviews")
  createdReviews           PerformanceReview[]   @relation("Reviewer")
  expenses                 Expense[]             @relation("ExpenseEmployee")
  paidExpenses             Expense[]             @relation("ExpensePaidBy")
  approvedExpenses         Expense[]             @relation("ExpenseApprovedBy")
  meetings                 Meeting[]
  baseSalary               Float?
  penalties                Penalty[]
  payrolls                 Payroll[]
  salaryDeductions         SalaryDeduction[]
  salaryAddons             SalaryAddon[]
  devices                  DeviceRegistration[]
  handledPettyCash         PettyCash[]           @relation("PettyCashHandler")
  createdPortfolioProjects PortfolioProject[]    @relation("CreatedPortfolioProjects")
  approvedTimeEntries      TimeEntry[]           @relation("TimeEntryApprover")
  projectPayments          ProjectPayment[]

  activitySession     UserActivitySession?
  idleLogs            IdleLog[]
  approvedIdleLogs    IdleLog[]            @relation("IdleApprovedBy")
  rejectedIdleLogs    IdleLog[]            @relation("IdleRejectedBy")
  pilotFeedbacks      PilotFeedback[]
  appHealthLogs       AppHealthLog[]
  crashLogs           CrashLog[]
  payslips            Payslip[]
  pushSubscriptions   PushSubscription[]
  notificationSetting NotificationSetting?
  messageMentions     MessageMention[]
  teamMembers         TeamMember[]
}

enum Role {
  ADMIN
  HR
  MANAGER
  PROJECT_MANAGER
  EMPLOYEE
  CLIENT
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

model Attendance {
  id               String                @id @default(uuid())
  employeeId       String
  employee         Employee              @relation(fields: [employeeId], references: [id])
  date             DateTime
  punchIn          DateTime?
  punchOut         DateTime?
  break1Start      DateTime?
  break1End        DateTime?
  break2Start      DateTime?
  break2End        DateTime?
  lunchStart       DateTime?
  lunchEnd         DateTime?
  status           AttendanceStatus      @default(PRESENT)
  totalHours       Float?
  earlyExitReason  String?
  adminNote        String?
  totalIdleMinutes Int                   @default(0)
  deviceLogs       AttendanceDeviceLog[]

  @@unique([employeeId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALFDAY
  WEEKEND
  WEEKEND_WORK
  AUTO_PUNCH_OUT
  HOLIDAY
  HOLIDAY_WORK
}

model AttendanceDeviceLog {
  id           String     @id @default(uuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  actionType   String // PUNCH_IN, PUNCH_OUT, BREAK_START, LUNCH_START, etc.

  deviceFingerprint String?
  deviceType        String? // Mobile, Desktop, Tablet
  loginSource       String? // WEB_DESKTOP, WEB_MOBILE, ANDROID_APP, IOS_APP, PWA
  deviceName        String?
  browser           String?
  browserVersion    String?
  os                String?
  osVersion         String?
  deviceModel       String?
  screenResolution  String?
  userAgent         String?
  ipAddress         String?
  timezone          String?
  language          String?

  // Future ready fields
  gpsLocation        String?
  officeNetwork      String?
  wifiName           String?
  vpnDetection       String?
  trustedDevice      Boolean? @default(false)
  verificationStatus String?

  createdAt DateTime @default(now())

  @@index([attendanceId])
  @@index([employeeId])
}

model Leave {
  id           String      @id @default(uuid())
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id])
  leaveType    String
  startDate    DateTime
  endDate      DateTime
  numberOfDays Int
  reason       String
  status       LeaveStatus @default(PENDING)
  isPaid       Boolean     @default(false)
  createdAt    DateTime    @default(now())
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Project {
  id               String             @id @default(uuid())
  projectId        String             @unique
  name             String
  description      String?
  managerId        String
  manager          Employee           @relation("ProjectManager", fields: [managerId], references: [id])
  teamId           String?
  team             Team?              @relation(fields: [teamId], references: [id])
  departmentId     String?
  department       Department?        @relation(fields: [departmentId], references: [id])
  clientId         String?
  client           Client?            @relation(fields: [clientId], references: [id])
  members          ProjectMember[]
  startDate        DateTime
  deadline         DateTime
  status           ProjectStatus      @default(PLANNING)
  brdUrl           String?
  links            Json?              @default("[]")
  tasks            Task[]
  documents        Document[]
  invoices         Invoice[]
  meetings         Meeting[]
  timeEntries      TimeEntry[]
  totalValue       Float?             @default(0)
  receivedAmount   Float?             @default(0)
  pendingAmount    Float?             @default(0)
  financeFinalized Boolean            @default(false)
  milestones       ProjectMilestone[]
  payments         ProjectPayment[]
  tickets          SupportTicket[]
  sprints          Sprint[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Sprint {
  id        String       @id @default(uuid())
  name      String
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  status    SprintStatus @default(PLANNED)
  tasks     Task[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

enum SprintStatus {
  PLANNED
  ACTIVE
  CLOSED
}

model ProjectMember {
  id         String      @id @default(uuid())
  projectId  String
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role       ProjectRole @default(DEVELOPER)
  joinedAt   DateTime    @default(now())

  @@unique([projectId, employeeId])
}

enum ProjectRole {
  DEVELOPER
  DESIGNER
  TESTER
  MANAGER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
}

model Task {
  id          String        @id @default(uuid())
  taskId      String        @unique
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id])
  title       String
  description String?
  assignedId  String?
  assignedTo  Employee?     @relation("AssignedTasks", fields: [assignedId], references: [id])
  createdById String?
  createdBy   Employee?     @relation("CreatedTasks", fields: [createdById], references: [id])
  priority    TaskPriority  @default(MEDIUM)
  status      TaskStatus    @default(TODO)
  issueType   TaskIssueType @default(TASK)
  storyPoints Float?
  sprintId    String?
  sprint      Sprint?       @relation(fields: [sprintId], references: [id])
  startDate   DateTime?
  deadline    DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  comments    Comment[]
  timeEntries TimeEntry[]
  subTasks    SubTask[]
  documents   Document[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([assignedId])
  @@index([projectId])
  @@index([sprintId])
}

enum TaskIssueType {
  EPIC
  STORY
  TASK
  BUG
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  TESTING
  COMPLETED
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  authorId  String
  author    Employee @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model Document {
  id         String   @id @default(uuid())
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id])
  name       String
  url        String
  type       String
  uploadedAt DateTime @default(now())
}

model SubTask {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      Employee         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
}

model ActivityLog {
  id         String   @id @default(cuid())
  type       String
  message    String
  entityType String
  entityId   String
  userId     String
  user       Employee @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([userId])
}

model TimeEntry {
  id                 String          @id @default(cuid())
  taskId             String?
  task               Task?           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId          String?
  project            Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startTime          DateTime        @default(now())
  endTime            DateTime?
  durationMinutes    Int?
  description        String?
  workCategory       WorkCategory?
  manualProjectName  String?
  productivityRating Int?
  idleMinutes        Float?
  screenshotUrl      String?
  isLocked           Boolean         @default(false)
  type               TimeEntryType   @default(TIMER)
  status             TimeEntryStatus @default(SUBMITTED)
  isBillable         Boolean         @default(true)
  date               DateTime        @default(now())

  approvedById    String?
  approvedBy      Employee? @relation("TimeEntryApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([taskId])
  @@index([projectId])
}

model UserActivitySession {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           Employee       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastActivityAt DateTime       @default(now())
  status         ActivityStatus @default(ACTIVE)
  deviceInfo     String?
  ipAddress      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

enum ActivityStatus {
  ACTIVE
  IDLE
  LOCKED
}

model IdleLog {
  id                  String             @id @default(cuid())
  userId              String
  user                Employee           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId           String?
  taskId              String?
  timerSessionId      String?
  deviceId            String?
  idleStartedAt       DateTime           @default(now())
  idleEndedAt         DateTime?
  idleDurationMinutes Int?
  reason              String?
  status              IdleApprovalStatus @default(PENDING_APPROVAL)
  approvedById        String?
  approvedBy          Employee?          @relation("IdleApprovedBy", fields: [approvedById], references: [id])
  approvedAt          DateTime?
  rejectedById        String?
  rejectedBy          Employee?          @relation("IdleRejectedBy", fields: [rejectedById], references: [id])
  rejectedAt          DateTime?
  adminComment        String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

enum IdleApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model TimerSession {
  id                     String               @id @default(cuid())
  employeeId             String               @unique
  taskId                 String?
  projectId              String?
  startTime              DateTime             @default(now())
  lastPausedAt           DateTime?
  totalPausedSeconds     Int                  @default(0)
  isActive               Boolean              @default(true)
  status                 TimerStatus          @default(RUNNING)
  totalIdleMinutes       Float                @default(0)
  lastActivityAt         DateTime             @default(now())
  autoPausedAt           DateTime?
  resumeRequiresApproval Boolean              @default(false)
  description            String?
  workCategory           WorkCategory?
  pauseIntervals         TimerPauseInterval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TimerStatus {
  RUNNING
  PAUSED
  IDLE_PAUSED
  STOPPED
}

model TimerPauseInterval {
  id             String       @id @default(cuid())
  timerSessionId String
  timerSession   TimerSession @relation(fields: [timerSessionId], references: [id], onDelete: Cascade)
  pausedAt       DateTime     @default(now())
  resumedAt      DateTime?
}

enum WorkCategory {
  DEVELOPMENT
  DESIGN
  MEETING
  RESEARCH
  QA
  DOCUMENTATION
  OTHER
}

enum TimeEntryStatus {
  RUNNING
  PAUSED
  SUBMITTED
  APPROVED
  REJECTED
}

enum TimeEntryType {
  TIMER
  MANUAL
}

enum NotificationType {
  TASK_ASSIGNED
  COMMENT_ADDED
  PROJECT_UPDATED
  DOCUMENT_UPLOADED
  TASK_DUE_SOON
  TASK_OVERDUE
  LATE_ARRIVAL
  ATTENDANCE_PUNCH_OUT
  SOD_REMINDER
  EOD_REMINDER
  PAYMENT_DUE_SOON
  PAYMENT_DUE_TODAY
  PAYMENT_OVERDUE
  TIMER_FORGOTTEN
  MISSING_TIMESHEET
  ENTRY_REJECTED
  LOW_TRACKED_HOURS
  PENDING_APPROVAL
  DEADLINE_APPROACHING
  LEAVE_APPROVED
  LEAVE_REJECTED
  PROJECT_ASSIGNED
}

model DailyReport {
  id             String   @id @default(cuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           DateTime
  sodText        String
  eodText        String?
  tasksCompleted String?
  blockers       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([employeeId, date])
}

model ChatRoom {
  id          String       @id @default(cuid())
  name        String?
  description String?
  avatarUrl   String?
  type        ChatType     @default(PERSONAL)
  members     ChatMember[]
  messages    Message[]

  isArchived Boolean @default(false)
  isDeleted  Boolean @default(false) // Soft delete for compliance
  createdBy  String? // Employee ID of the creator for custom groups

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ChatType {
  PERSONAL
  GROUP
  DEPARTMENT
  HR_SUPPORT
}

model ChatMember {
  id         String   @id @default(cuid())
  roomId     String
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  isAdmin    Boolean      @default(false)
  isPinned   Boolean      @default(false)
  isFavorite Boolean      @default(false)
  isMuted    Boolean      @default(false)
  priority   ChatPriority @default(MEDIUM)
  lastReadAt DateTime?

  @@unique([roomId, employeeId])
  @@unique([roomId, clientId])
}

enum ChatPriority {
  HIGH
  MEDIUM
  LOW
}

model Message {
  id         String    @id @default(cuid())
  roomId     String
  room       ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId   String?
  sender     Employee?  @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderClientId String?
  senderClient   Client? @relation("ClientSentMessages", fields: [senderClientId], references: [id], onDelete: Cascade)
  receiverId String?
  receiver   Employee? @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverClientId String?
  receiverClient   Client? @relation("ClientReceivedMessages", fields: [receiverClientId], references: [id], onDelete: Cascade)
  content    String
  fileUrl    String?
  fileType   String?

  // To track @mentions
  mentions MessageMention[]

  createdAt DateTime @default(now())

  @@index([roomId])
  @@index([senderId])
  @@index([createdAt])
}

model MessageMention {
  id         String   @id @default(cuid())
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([messageId, employeeId])
}

model Invoice {
  id           String        @id @default(cuid())
  clientName   String
  clientId     String?
  client       Client?       @relation(fields: [clientId], references: [id])
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id])
  amount       Float
  status       InvoiceStatus @default(DRAFT)
  dueDate      DateTime
  approvedAt   DateTime?
  paidAt       DateTime?
  paymentMode  String?
  transactionId String?
  notes        String?
  items        InvoiceItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum InvoiceStatus {
  DRAFT
  SENT
  APPROVED
  PAID
  OVERDUE
  CANCELLED
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  hours       Float? // Optional for fixed-price items
  rate        Float? // Optional for fixed-price items
  total       Float
}

model Lead {
  id         String     @id @default(cuid())
  name       String
  email      String     @unique
  phone      String?
  source     String? // LinkedIn, Website, Referral
  status     LeadStatus @default(NEW)
  assignedId String?
  assignedTo Employee?  @relation(fields: [assignedId], references: [id])
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

model Client {
  id            String        @id @default(cuid())
  clientId      String        @unique
  name          String
  email         String?       @unique
  phone         String?
  company       String?
  password      String
  status        ClientStatus  @default(ACTIVE)
  projects      Project[]
  invoices      Invoice[]
  tickets       SupportTicket[]
  chatMembers   ChatMember[]
  sentMessages  Message[]     @relation("ClientSentMessages")
  receivedMessages Message[]  @relation("ClientReceivedMessages")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model PerformanceReview {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation("EmployeeReviews", fields: [employeeId], references: [id])
  reviewerId String
  reviewer   Employee @relation("Reviewer", fields: [reviewerId], references: [id])
  rating     Int // 1-5
  feedback   String
  period     String // Q1 2024, Annual 2024
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Expense {
  id           String        @id @default(cuid())
  employeeId   String?
  employee     Employee?     @relation("ExpenseEmployee", fields: [employeeId], references: [id])
  amount       Float
  category     String // Travel, Meals, Software, Gadgets
  description  String
  status       ExpenseStatus @default(PENDING)
  receiptUrl   String?
  paymentMode  String?
  paidById     String?
  paidBy       Employee?     @relation("ExpensePaidBy", fields: [paidById], references: [id])
  approvedById String?
  approvedBy   Employee?     @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  date         DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

model Revenue {
  id          String   @id @default(cuid())
  amount      Float
  source      String // Client, Project, Service, etc.
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Meeting {
  id           String     @id @default(cuid())
  title        String
  startTime    DateTime
  endTime      DateTime
  location     String? // G-Meet, Office, External
  projectId    String?
  project      Project?   @relation(fields: [projectId], references: [id])
  meetingUrl   String?
  participants Employee[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Penalty {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount     Float
  reason     String
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Payroll {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month      Int
  year       Int
  baseSalary Float

  presentDays     Int   @default(0)
  leaveDays       Int   @default(0)
  unpaidLeaveDays Int   @default(0)
  lateMarks       Int   @default(0)
  halfDays        Int   @default(0)
  overtimeHours   Float @default(0)
  productiveHours Float @default(0)
  bonus           Float @default(0)

  totalPenalties  Float         @default(0)
  totalDeductions Float         @default(0)
  netSalary       Float
  status          PayrollStatus @default(PENDING)

  paymentMode String?
  paymentDate DateTime?
  paymentProof String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, month, year])
}

enum PayrollStatus {
  PENDING
  PAID
}

model Holiday {
  id        String      @id @default(cuid())
  name      String
  date      DateTime
  endDate   DateTime?
  type      HolidayType @default(PUBLIC)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum HolidayType {
  PUBLIC
  COMPANY
}

model SystemSettings {
  id                String  @id @default("default")
  officeStartTime   String  @default("09:30")
  lateThreshold     String  @default("09:45")
  lateComingEnabled Boolean @default(false)
  halfDayEnabled    Boolean @default(false)
  lunchDuration     Int     @default(60) // in minutes
  breakDuration     Int     @default(30) // in minutes
  sodReminderTime   String  @default("11:00")
  eodReminderTime   String  @default("19:30")

  // Idle detection settings
  idleTimeoutMinutes      Int     @default(10)
  idleWarningSeconds      Int     @default(60)
  autoPauseTimerEnabled   Boolean @default(true)
  requireApprovalToResume Boolean @default(true)

  // Desktop App settings
  desktopAppEnabledRoles   String[] @default(["EMPLOYEE", "HR", "MANAGER", "PROJECT_MANAGER"])
  heartbeatIntervalSeconds Int      @default(60)
  autoStartEnabled         Boolean  @default(true)

  // Custom Rules
  ruleBookText String? @default("")

  // Finance
  financePin String?

  updatedAt DateTime @updatedAt
}

model PortfolioProject {
  id               String    @id @default(uuid())
  title            String
  description      String?
  projectLink      String?
  technologiesUsed String?
  completionDate   DateTime?

  createdById String
  createdBy   Employee @relation("CreatedPortfolioProjects", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalaryDeduction {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       String // Late, Unpaid Leave, Advance, Loan, Penalty, Custom
  amount     Float
  reason     String
  date       DateTime @default(now())
  month      Int
  year       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SalaryAddon {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       String // Bonus, Incentive, Arrears, Custom
  amount     Float
  reason     String
  date       DateTime @default(now())
  month      Int
  year       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PettyCash {
  id             String   @id @default(cuid())
  date           DateTime @default(now())
  type           String // IN, OUT
  amount         Float
  category       String?
  remarks        String?
  handledById    String
  handledBy      Employee @relation("PettyCashHandler", fields: [handledById], references: [id])
  closingBalance Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectMilestone {
  id         String          @id @default(uuid())
  projectId  String
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  amount     Float
  paidAmount Float           @default(0)
  dueDate    DateTime
  releaseDate DateTime?
  completedAt DateTime?
  status     MilestoneStatus @default(PENDING)

  // Reminders
  reminderSentOneDayBefore Boolean   @default(false)
  reminderSentOnDueDate    Boolean   @default(false)
  reminderSentOverdue      Boolean   @default(false)
  lastReminderSentAt       DateTime?

  notes     String?
  payments  ProjectPayment[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

enum MilestoneStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

model ProjectPayment {
  id               String            @id @default(uuid())
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId      String?
  milestone        ProjectMilestone? @relation(fields: [milestoneId], references: [id])
  amount           Float
  date             DateTime          @default(now())
  mode             String // Cash, Bank, UPI
  transactionId    String? // Unique identifier from the payment gateway/bank
  paymentReference String? // Manual reference or notes
  receiptUrl       String? // URL to payment proof/receipt
  createdById      String
  createdBy        Employee          @relation(fields: [createdById], references: [id])
  notes            String?
}

model DeviceRegistration {
  id           String           @id @default(cuid())
  userId       String
  user         Employee         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String           @unique
  deviceName   String?
  os           String?
  appVersion   String?
  isRevoked    Boolean          @default(false)
  lastSeenAt   DateTime         @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  heartbeats   AgentHeartbeat[]
  systemEvents SystemEventLog[]
}

model AgentHeartbeat {
  id             String             @id @default(cuid())
  deviceId       String
  device         DeviceRegistration @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
  status         ActivityStatus     @default(ACTIVE)
  timerSessionId String?
  timestamp      DateTime           @default(now())
}

model SystemEventLog {
  id        String             @id @default(cuid())
  deviceId  String
  device    DeviceRegistration @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
  eventType SystemEventType
  timestamp DateTime           @default(now())
}

enum SystemEventType {
  SLEEP
  WAKE
  LOCK
  UNLOCK
  SHUTDOWN
  STARTUP
}

model PilotFeedback {
  id                  String   @id @default(cuid())
  userId              String
  user                Employee @relation(fields: [userId], references: [id], onDelete: Cascade)
  isIdleAccurate      Boolean
  hadFalsePause       Boolean
  hasPerformanceIssue Boolean
  rating              Int
  comment             String?
  appVersion          String?
  createdAt           DateTime @default(now())
}

model AppHealthLog {
  id              String   @id @default(cuid())
  userId          String
  user            Employee @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId        String
  cpuUsage        Float
  ramUsage        Float
  syncStatus      String
  heartbeatStatus String
  timestamp       DateTime @default(now())
}

model CrashLog {
  id           String   @id @default(cuid())
  userId       String
  user         Employee @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String
  errorStack   String?
  errorMessage String
  appVersion   String?
  os           String?
  timestamp    DateTime @default(now())
}

model Announcement {
  id        String    @id @default(uuid())
  title     String
  message   String
  priority  String    @default("LOW") // LOW, MEDIUM, HIGH
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Event {
  id          String   @id @default(uuid())
  title       String
  type        String // OUTING, TRAINING, MEETING, CELEBRATION
  location    String?
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payslip {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month      String // e.g. "March 2026"
  period     String // e.g. "Mar 01 - Mar 31"
  monthInt   Int    // month number for filtering/upsert
  yearInt    Int    // year for filtering/upsert
  netSalary  Float
  data       Json?  // full slip snapshot (earnings, deductions, attendance)
  fileUrl    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, monthInt, yearInt])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      Employee @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationSetting {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         Employee @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabledTypes String[] // Array of enabled notification types (empty means none)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SupportTicket {
  id          String       @id @default(cuid())
  ticketNo    String       @unique
  clientId    String
  client      Client       @relation(fields: [clientId], references: [id])
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id])
  subject     String
  description String
  category    TicketCategory @default(QUERY)
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)
  assignedTo  String?
  replies     TicketReply[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model TicketReply {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderType String   // CLIENT or EMPLOYEE
  senderId   String
  senderName String
  message    String
  createdAt  DateTime @default(now())
}

enum TicketCategory {
  BUG
  FEATURE
  QUERY
  FEEDBACK
  BILLING
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}
